{
  "schemaVersion": 1,
  "id": "mgf-sample-interop",
  "version": "${version}",
  "name": "MGF Sample: Interop",
  "description": "M0/M1 verification: requests Vulkan device extensions through MGF and logs the negotiated device state at startup.",
  "authors": [
    "PrliStrxs"
  ],
  "contact": {},
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.mgf.samples.interop.SampleInteropClient"
    ],
    "mgf:vulkan_boot": [
      "dev.mgf.samples.interop.SampleVulkanBoot"
    ],
    "mgf:providers": [
      "dev.mgf.samples.interop.SampleProviders"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "minecraft": "26.2",
    "java": ">=25",
    "mgf": "*"
  }
}
